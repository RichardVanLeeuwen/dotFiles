{ config, lib, pkgs, modulesPath, ... }:

{
  imports =
    [ (modulesPath + "/installer/scan/not-detected.nix")
    ];

  boot.initrd.availableKernelModules = [ "xhci_pci" "ahci" "usbhid" "usb_storage" "sd_mod" ];
  boot.initrd.kernelModules = [ ];
  boot.kernelModules = [ "kvm-intel" ];
  boot.extraModulePackages = [ ];

  fileSystems."/" =
    { device = "/dev/disk/by-uuid/79202a56-e78a-4c52-a9f4-e23a68fb5458";
      fsType = "ext4";
    };

  fileSystems."/boot" =
    { device = "/dev/disk/by-uuid/7A1D-9972";
      fsType = "vfat";
      options = [ "fmask=0022" "dmask=0022" ];
    };

  fileSystems."/home" =
    { device = "/dev/disk/by-uuid/565d1a0c-5bff-4ed3-9561-06194e6687bd";
      fsType = "ext4";
    };

  environment.systemPackages = [ pkgs.cifs-utils ];

  # connecting to a smb drive
  fileSystems."/nas/richard" =
    {
      device = "//10.0.20.183/richard";
      fsType = "cifs";
      options = [
        "credentials=/etc/credentials/.nas"
        "uid=1000"
        "gid=1000"
        "x-systemd.automount"
        "noauto"
        "x-systemd.idle-timeout=60"
        "x-systemd.device-timeout=5s"
        "x-systemd.mount-timeout=5s"
      ];
    };

  fileSystems."/nas/linda" =
    {
      device = "//10.0.20.183/linda";
      fsType = "cifs";
      options = [ "credentials=/etc/credentials/.nas" "uid=1000" "gid=1000" "x-systemd.automount" "noauto" "x-systemd.idle-timeout=60" "x-systemd.device-timeout=5s" "x-systemd.mount-timeout=5s" ];
    };

  fileSystems."/nas/immich" =
    {
      device = "//10.0.20.183/immich";
      fsType = "cifs";
      options = [ "credentials=/etc/credentials/.nas" "uid=1000" "gid=1000" "x-systemd.automount" "noauto" "x-systemd.idle-timeout=60" "x-systemd.device-timeout=5s" "x-systemd.mount-timeout=5s" ];
    };

  fileSystems."/nas/nextcloud" =
    {
      device = "//10.0.20.183/nextcloud";
      fsType = "cifs";
      options = [ "credentials=/etc/credentials/.nas" "uid=1000" "gid=1000" "x-systemd.automount" "noauto" "x-systemd.idle-timeout=60" "x-systemd.device-timeout=5s" "x-systemd.mount-timeout=5s" ];
    };

  swapDevices = [ ];

  nixpkgs.hostPlatform = lib.mkDefault "x86_64-linux";
  hardware.cpu.intel.updateMicrocode = lib.mkDefault config.hardware.enableRedistributableFirmware;
}
